#!/bin/sh
# 커밋 전 백엔드 정적 검사 — 정의되지 않은 이름(F821)만 막는다.
#
# 왜 필요한가:
#   이 저장소는 CI·테스트가 없다. 유일한 검증이 프로덕션에서 사람이 발견하는 것이었고,
#   그래서 아래 넷이 최대 4개월간 살아 있었다(2026-08-24 실측).
#     · init_database 가 604행에서 중단 → mail_signals 테이블 누락 (3개월)
#     · _fetch_ga4_data 의 requests 미정의 → GA4 지표 조회 불가
#     · 정의 없는 _check_profile_match 호출 (4개월)
#     · 결제 주문 API 의 _uuid 미정의 → 500 (하루)
#   전부 0.5초짜리 검사 한 번에 걸린다.
#
# 설치:  git config core.hooksPath .githooks
# 우회:  git commit --no-verify   (급할 때만. 우회했으면 다음 커밋 전에 고칠 것)

# 스테이징된 백엔드 파이썬 파일이 없으면 건너뛴다
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep '^backend/.*\.py$')
[ -z "$STAGED" ] && exit 0

if ! python -m ruff --version >/dev/null 2>&1; then
  echo "⚠  ruff 가 없어 검사를 건너뜁니다.  설치:  pip install ruff"
  exit 0
fi

cd backend || exit 0
if ! python -m ruff check app/ --no-cache -q; then
  echo ""
  echo "✗ 정의되지 않은 이름이 있습니다. 실행하면 NameError 로 터집니다."
  echo "  고친 뒤 다시 커밋하십시오.   확인:  cd backend && python -m ruff check app/"
  echo "  (정말 급하면  git commit --no-verify)"
  exit 1
fi
exit 0
